{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-capabilities",
  "description": "Capability for mobile main window",
  "platforms": [
    "android",
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "log:default",
    "process:default",
    "clipboard-manager:default"
  ]
}