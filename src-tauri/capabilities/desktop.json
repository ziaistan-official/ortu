{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-capabilities",
  "description": "Capability for desktop main window",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main",
    "popup"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "global-shortcut:default",
    "positioner:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "autostart:default",
    "log:default",
    "updater:default",
    "process:default"
  ]
}